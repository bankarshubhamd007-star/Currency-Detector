<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Fake Currency Detection</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #667eea;
            --secondary: #764ba2;
            --success: #11998e;
            --success-light: #38ef7d;
            --danger: #eb3b5a;
            --danger-light: #fc5c65;
            --bg-light: #f8f9fa;
            --bg-lighter: #ffffff;
            --text-dark: #333333;
            --text-light: #666666;
            --border-light: #e9ecef;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            min-height: 100vh;
            padding: 20px;
            transition: background 0.3s ease;
        }

        body.dark-mode {
            --bg-light: #2d3748;
            --bg-lighter: #1a202c;
            --text-dark: #e2e8f0;
            --text-light: #cbd5e0;
            --border-light: #4a5568;
            background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: var(--bg-lighter);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            transition: background 0.3s ease;
        }

        .header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            padding: 40px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .header-center {
            flex: 1;
            min-width: 250px;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.95;
            font-weight: 300;
        }

        .header-controls {
            display: flex;
            gap: 10px;
        }

        .theme-toggle {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            padding: 10px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1.2em;
            transition: background 0.3s ease;
        }

        .theme-toggle:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        .content {
            padding: 40px 30px;
            color: var(--text-dark);
        }

        .card {
            background: var(--bg-light);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            border: 1px solid var(--border-light);
            transition: all 0.3s ease;
        }

        .card h2 {
            color: var(--text-dark);
            margin-bottom: 20px;
            font-size: 1.4em;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .input-group {
            margin-bottom: 15px;
        }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-light);
            font-weight: 600;
            font-size: 0.95em;
        }

        .drag-drop-area {
            border: 2px dashed var(--primary);
            border-radius: 10px;
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: rgba(102, 126, 234, 0.05);
        }

        .drag-drop-area:hover,
        .drag-drop-area.dragging {
            border-color: var(--secondary);
            background: rgba(102, 126, 234, 0.1);
            transform: translateY(-2px);
        }

        .drag-drop-area.dragging {
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.2);
        }

        .drag-icon {
            font-size: 3em;
            margin-bottom: 10px;
        }

        .upload-input {
            display: none;
        }

        .text-input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid var(--border-light);
            border-radius: 10px;
            background: var(--bg-lighter);
            color: var(--text-dark);
            font-size: 0.95em;
            transition: all 0.3s ease;
        }

        .text-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .file-info {
            margin-top: 10px;
            font-size: 0.85em;
            color: var(--text-light);
            padding: 10px;
            background: rgba(102, 126, 234, 0.05);
            border-radius: 5px;
            display: none;
        }

        .file-info.show {
            display: block;
        }

        .or-divider {
            text-align: center;
            margin: 20px 0;
            color: var(--text-light);
            font-weight: 600;
            position: relative;
        }

        .or-divider::before,
        .or-divider::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 45%;
            height: 1px;
            background: var(--border-light);
        }

        .or-divider::before {
            left: 0;
        }

        .or-divider::after {
            right: 0;
        }

        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .btn {
            flex: 1;
            min-width: 120px;
            padding: 12px 20px;
            border: none;
            border-radius: 10px;
            font-size: 0.95em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .btn-secondary {
            background: var(--border-light);
            color: var(--text-light);
        }

        .btn-secondary:hover {
            background: #dee2e6;
        }

        .btn-back {
            background: #6c757d;
            color: white;
        }

        .btn-back:hover {
            background: #5a6268;
        }

        .loading-spinner {
            display: none;
            justify-content: center;
            align-items: center;
            padding: 60px 40px;
            text-align: center;
        }

        .loading-spinner.show {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .spinner {
            border: 4px solid var(--border-light);
            border-top: 4px solid var(--primary);
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .results-container {
            display: flex;
            gap: 30px;
            align-items: flex-start;
        }

        .image-section {
            flex: 1;
            text-align: center;
        }

        .image-section img {
            max-width: 100%;
            max-height: 400px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .analysis-section {
            flex: 1;
        }

        .prediction-badge {
            display: inline-block;
            padding: 20px 40px;
            border-radius: 50px;
            font-size: 1.8em;
            font-weight: 700;
            margin: 20px 0;
            text-transform: uppercase;
            letter-spacing: 1px;
            width: 100%;
            text-align: center;
        }

        .badge-real {
            background: linear-gradient(135deg, var(--success) 0%, var(--success-light) 100%);
            color: white;
            box-shadow: 0 5px 15px rgba(17, 153, 142, 0.3);
        }

        .badge-fake {
            background: linear-gradient(135deg, var(--danger) 0%, var(--danger-light) 100%);
            color: white;
            box-shadow: 0 5px 15px rgba(235, 59, 90, 0.3);
        }

.result-info-container {
            margin: 30px 0;
            background: var(--bg-light);
            padding: 25px;
            border-radius: 15px;
            border: 1px solid var(--border-light);
        }

        .result-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .info-item {
            background: var(--bg-lighter);
            padding: 15px;
            border-radius: 10px;
            border-left: 4px solid var(--primary);
        }

        .info-label {
            font-size: 0.9em;
            color: var(--text-light);
            margin-bottom: 8px;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .info-value {
            font-size: 1.4em;
            color: var(--text-dark);
            font-weight: 700;
        }

        .result-details {
            background: var(--bg-lighter);
            padding: 15px;
            border-radius: 10px;
            border-left: 4px solid var(--success);
            margin-top: 15px;
        }

        .result-details-label {
            font-size: 0.9em;
            color: var(--text-light);
            margin-bottom: 8px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .result-details-text {
            font-size: 0.95em;
            color: var(--text-dark);
            line-height: 1.6;
        }
            box-shadow: 0 0 10px rgba(102, 126, 234, 0.5);
        }

        .tips-card {
            background: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 20px;
            border-radius: 10px;
            margin-top: 25px;
            color: #333;
        }

        body.dark-mode .tips-card {
            background: #5a4a00;
            color: #ffd580;
        }

        .tips-card h3 {
            color: #997404;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        body.dark-mode .tips-card h3 {
            color: #ffd580;
        }

        .tips-list {
            list-style: none;
        }

        .tips-list li {
            color: inherit;
            padding: 8px 0;
            padding-left: 25px;
            position: relative;
            font-size: 0.95em;
        }

        .tips-list li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: #28a745;
            font-weight: bold;
            font-size: 1.2em;
        }

        .error-message {
            display: none;
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            color: #721c24;
            padding: 15px;
            border-radius: 10px;
            margin-top: 20px;
        }

        body.dark-mode .error-message {
            background: #5a2a2a;
            border-color: #8a3a3a;
            color: #ff9999;
        }

        .error-message.show {
            display: block;
            animation: slideIn 0.5s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .back-button-section {
            margin-top: 30px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .history-panel {
            background: var(--bg-light);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 25px;
            border: 1px solid var(--border-light);
            max-height: 350px;
            overflow-y: auto;
        }

        .history-panel h3 {
            color: var(--text-dark);
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .history-item {
            background: var(--bg-lighter);
            padding: 12px;
            margin-bottom: 10px;
            border-radius: 8px;
            border: 1px solid var(--border-light);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .history-item:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
        }

        .history-item-info {
            flex: 1;
            min-width: 0;
        }

        .history-item-name {
            font-weight: 600;
            color: var(--text-dark);
            font-size: 0.9em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .history-item-time {
            font-size: 0.8em;
            color: var(--text-light);
        }

        .history-item-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8em;
            font-weight: 600;
            white-space: nowrap;
        }

        .history-item-badge-real {
            background: rgba(17, 153, 142, 0.2);
            color: var(--success);
        }

        .history-item-badge-fake {
            background: rgba(235, 59, 90, 0.2);
            color: var(--danger);
        }

        .clear-history-btn {
            background: none;
            border: none;
            color: var(--text-light);
            cursor: pointer;
            font-size: 0.8em;
            padding: 4px 8px;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .clear-history-btn:hover {
            background: var(--border-light);
            color: var(--text-dark);
        }

        .empty-history {
            text-align: center;
            color: var(--text-light);
            padding: 20px;
            font-size: 0.9em;
        }

        @media (max-width: 768px) {
            .header {
                flex-direction: column;
                text-align: center;
            }

            .header-center {
                order: -1;
            }

            .results-container {
                flex-direction: column;
                gap: 20px;
            }

            .header h1 {
                font-size: 1.8em;
            }

            .content {
                padding: 20px;
            }

            .card {
                padding: 15px;
            }

            .prediction-badge {
                font-size: 1.3em;
                padding: 15px 30px;
            }

            .button-group {
                flex-direction: column;
            }

            .drag-drop-area {
                padding: 30px 15px;
            }

            .btn {
                min-width: 100%;
            }

            .drag-icon {
                font-size: 2em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="header-center">
                <h1>🔍 AI Fake Currency Detection</h1>
                <p>Upload an Indian currency note and let AI verify it.</p>
            </div>
            <div class="header-controls">
                <button class="theme-toggle" id="themeToggle" title="Toggle Dark Mode">🌙</button>
            </div>
        </div>

        <!-- Upload Page -->
        <div id="uploadPage" class="page active">
            <div class="content">
                <!-- History Panel -->
                <div class="history-panel" id="historyPanel" style="display: none;">
                    <h3>
                        📊 Recent Predictions
                        <button class="clear-history-btn" id="clearHistoryBtn" title="Clear History">✕</button>
                    </h3>
                    <div id="historyList"></div>
                </div>

                <!-- Upload Card -->
                <div class="card">
                    <h2>📤 Upload or Enter Image URL</h2>
                    
                    <div class="input-group">
                        <label>Choose Image File (Drag & Drop or Click)</label>
                        <div class="drag-drop-area" id="dragDropArea">
                            <div class="drag-icon">📁</div>
                            <div style="font-weight: 600;">Drag your image here</div>
                            <div style="font-size: 0.9em; margin-top: 5px;">or click to select file</div>
                            <div style="font-size: 0.85em; color: var(--text-light); margin-top: 10px;">
                                Max size: 10MB | Supported: JPG, PNG, GIF
                            </div>
                        </div>
                        <input 
                            type="file" 
                            id="fileInput" 
                            class="upload-input" 
                            accept="image/*"
                        >
                        <div class="file-info" id="fileInfo"></div>
                    </div>

                    <div class="or-divider">OR</div>

                    <div class="input-group">
                        <label for="urlInput">Image URL</label>
                        <input 
                            type="text" 
                            id="urlInput" 
                            class="text-input" 
                            placeholder="https://example.com/image.jpg"
                        >
                    </div>

                    <div class="button-group">
                        <button id="predictBtn" class="btn btn-primary">Analyze Currency</button>
                        <button id="clearBtn" class="btn btn-secondary">Clear</button>
                    </div>

                    <div id="errorMessage" class="error-message"></div>
                </div>

                <!-- Tips Section on Upload Page -->
                <div class="tips-card">
                    <h3>💡 Tips to Identify Fake Currency Manually:</h3>
                    <ul class="tips-list">
                        <li><strong>Watermark:</strong> Check if watermark is clearly visible and matches the portrait</li>
                        <li><strong>Security Thread:</strong> Look for embedded security thread with text</li>
                        <li><strong>Color Shift:</strong> Observe color-shifting ink on the front right side</li>
                        <li><strong>Printing Quality:</strong> Check for sharp, clear printing without smudges</li>
                        <li><strong>Paper Texture:</strong> Feel the texture - should be smooth with a specific feel</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Results Page -->
        <div id="resultsPage" class="page">
            <div class="content">
                <!-- Loading Spinner -->
                <div id="loadingSpinner" class="loading-spinner show">
                    <div class="spinner"></div>
                    <span style="color: var(--primary); font-weight: 600;">Analyzing currency...</span>
                </div>

                <!-- Results Display -->
                <div id="resultsDisplay" style="display: none;">
                    <div class="results-container" id="resultsContent">
                        <!-- Image Section -->
                        <div class="image-section">
                            <label style="color: var(--text-light); font-weight: 600; display: block; margin-bottom: 10px;">Uploaded Image</label>
                            <img id="resultImage" alt="Uploaded Currency">
                        </div>

                        <!-- Analysis Section -->
                        <div class="analysis-section">
                            <h2 style="margin-bottom: 20px;">Analysis Result</h2>
                            
                            <div id="predictionBadge" class="prediction-badge"></div>

                            <div class="result-info-container">
                                <div class="result-info-grid">
                                    <div class="info-item">
                                        <div class="info-label">🤖 AI Model</div>
                                        <div class="info-value" style="font-size: 1em;">EfficientNetV2-S (Fine-tuned)</div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">✓ Analysis Complete</div>
                                        <div class="info-value" style="font-size: 1em; color: var(--success);">Ready</div>
                                    </div>
                                </div>
                                <div class="result-details">
                                    <div class="result-details-label">⚠️ Important Notice</div>
                                    <div class="result-details-text">
                                        This AI model provides an initial assessment only. For critical decisions involving legal or financial implications, always verify results with official currency authentication methods and authorized financial institutions.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tips Section on Results Page -->
                    <div class="tips-card">
                        <h3>💡 Tips to Identify Fake Currency Manually:</h3>
                        <ul class="tips-list">
                            <li><strong>Watermark:</strong> Check if watermark is clearly visible</li>
                            <li><strong>Security Thread:</strong> Look for embedded security thread with text</li>
                            <li><strong>Color Shift:</strong> Observe color-shifting ink patterns</li>
                            <li><strong>Printing Quality:</strong> Verify sharp, clear printing</li>
                            <li><strong>Serial Number:</strong> Verify serial number is properly printed</li>
                        </ul>
                    </div>

                    <!-- Back Button -->
                    <div class="back-button-section">
                        <button id="backBtn" class="btn btn-back">← Back to Upload</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // DOM Elements - Upload Page
        const uploadPage = document.getElementById('uploadPage');
        const resultsPage = document.getElementById('resultsPage');
        const dragDropArea = document.getElementById('dragDropArea');
        const fileInput = document.getElementById('fileInput');
        const urlInput = document.getElementById('urlInput');
        const fileInfo = document.getElementById('fileInfo');
        const predictBtn = document.getElementById('predictBtn');
        const clearBtn = document.getElementById('clearBtn');
        const backBtn = document.getElementById('backBtn');
        const themeToggle = document.getElementById('themeToggle');
        const errorMessage = document.getElementById('errorMessage');
        const historyPanel = document.getElementById('historyPanel');
        const historyList = document.getElementById('historyList');
        const clearHistoryBtn = document.getElementById('clearHistoryBtn');

        // DOM Elements - Results Page
        const loadingSpinner = document.getElementById('loadingSpinner');
        const resultsDisplay = document.getElementById('resultsDisplay');
        const resultsContent = document.getElementById('resultsContent');
        const resultImage = document.getElementById('resultImage');
        const predictionBadge = document.getElementById('predictionBadge');

        let currentFile = null;
        let currentUrl = null;
        let currentResult = null;

        // Constants
        const MAX_FILE_SIZE = 10 * 1024 * 1024; // 10MB
        const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];

        // Initialize
        loadTheme();
        loadHistory();

        // ==================== THEME TOGGLE ====================
        function loadTheme() {
            if (localStorage.getItem('theme') === 'dark') {
                document.body.classList.add('dark-mode');
                themeToggle.textContent = '☀️';
            }
        }

        themeToggle.addEventListener('click', function() {
            document.body.classList.toggle('dark-mode');
            if (document.body.classList.contains('dark-mode')) {
                localStorage.setItem('theme', 'dark');
                themeToggle.textContent = '☀️';
            } else {
                localStorage.setItem('theme', 'light');
                themeToggle.textContent = '🌙';
            }
        });

        // ==================== DRAG & DROP ====================
        dragDropArea.addEventListener('click', () => fileInput.click());

        dragDropArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            dragDropArea.classList.add('dragging');
        });

        dragDropArea.addEventListener('dragleave', () => {
            dragDropArea.classList.remove('dragging');
        });

        dragDropArea.addEventListener('drop', (e) => {
            e.preventDefault();
            dragDropArea.classList.remove('dragging');
            
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                handleFileSelect(files[0]);
            }
        });

        // ==================== FILE VALIDATION ====================
        function validateFile(file) {
            if (!ALLOWED_TYPES.includes(file.type)) {
                return { valid: false, error: '❌ Invalid file type. Please upload JPG, PNG, GIF, or WebP' };
            }
            if (file.size > MAX_FILE_SIZE) {
                return { valid: false, error: '❌ File size exceeds 10MB limit' };
            }
            return { valid: true };
        }

        function handleFileSelect(file) {
            const validation = validateFile(file);
            
            if (!validation.valid) {
                showError(validation.error);
                return;
            }

            currentFile = file;
            currentUrl = null;
            urlInput.value = '';
            clearError();

            const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
            fileInfo.textContent = `✓ Selected: ${file.name} (${sizeMB}MB)`;
            fileInfo.classList.add('show');
        }

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                handleFileSelect(e.target.files[0]);
            }
        });

        // ==================== PAGE NAVIGATION ====================
        function goToUploadPage() {
            uploadPage.classList.add('active');
            resultsPage.classList.remove('active');
            clearError();
        }

        function goToResultsPage() {
            uploadPage.classList.remove('active');
            resultsPage.classList.add('active');
            loadingSpinner.classList.add('show');
            resultsDisplay.style.display = 'none';
        }

        // ==================== URL INPUT ====================
        urlInput.addEventListener('input', function() {
            if (urlInput.value) {
                currentUrl = urlInput.value.trim();
                currentFile = null;
                fileInput.value = '';
                fileInfo.classList.remove('show');
                clearError();
            }
        });

        // ==================== PREDICTION ====================
        predictBtn.addEventListener('click', async function() {
            if (!currentFile && !currentUrl) {
                showError('Please upload an image or enter an image URL');
                return;
            }

            goToResultsPage();
            await makePrediction(currentFile, currentUrl);
        });

        async function makePrediction(file, url) {
            try {
                const formData = new FormData();
                
                if (file) {
                    formData.append('file', file);
                } else {
                    formData.append('image_url', url);
                }

                const response = await fetch('/predict', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.detail || 'Prediction failed');
                }

                const result = await response.json();
                displayResult(result, file, url);
                saveToHistory(result, file, url);

            } catch (error) {
                loadingSpinner.classList.remove('show');
                resultsDisplay.style.display = 'block';
                showErrorOnResults(error.message);
                goToUploadPage();
            }
        }

        function displayResult(result, file, url) {
            currentResult = result;
            const { prediction, confidence, is_real } = result;

            // Display image
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    resultImage.src = event.target.result;
                };
                reader.readAsDataURL(file);
            } else if (url) {
                resultImage.src = url;
            }

            // Update badge
            predictionBadge.textContent = prediction;
            predictionBadge.classList.remove('badge-real', 'badge-fake');
            predictionBadge.classList.add(is_real ? 'badge-real' : 'badge-fake');

            // Store result (confidence kept internal for logging)
            // Display only prediction to user

            // Show results
            loadingSpinner.classList.remove('show');
            resultsDisplay.style.display = 'block';
        }

        // ==================== HISTORY MANAGEMENT ====================
        function saveToHistory(result, file, url) {
            let history = JSON.parse(localStorage.getItem('predictionHistory')) || [];
            
            const fileName = file ? file.name : (url ? url.split('/').pop() || 'URL Image' : 'Image');
            
            let imageData = null;
            
            // For file uploads, store base64 image data
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    imageData = event.target.result;
                    
                    history.unshift({
                        id: Date.now(),
                        name: fileName,
                        prediction: result.prediction,
                        confidence: result.confidence,
                        timestamp: new Date().toLocaleString(),
                        is_real: result.is_real,
                        imageData: imageData,  // Base64 encoded image
                        imageUrl: null
                    });

                    // Keep only last 10
                    history = history.slice(0, 10);
                    localStorage.setItem('predictionHistory', JSON.stringify(history));
                    loadHistory();
                };
                reader.readAsDataURL(file);
            } else {
                // For URL uploads, store the URL
                history.unshift({
                    id: Date.now(),
                    name: fileName,
                    prediction: result.prediction,
                    confidence: result.confidence,
                    timestamp: new Date().toLocaleString(),
                    is_real: result.is_real,
                    imageData: null,
                    imageUrl: url
                });

                // Keep only last 10
                history = history.slice(0, 10);
                localStorage.setItem('predictionHistory', JSON.stringify(history));
                loadHistory();
            }
        }

        function loadHistory() {
            const history = JSON.parse(localStorage.getItem('predictionHistory')) || [];
            
            if (history.length === 0) {
                historyPanel.style.display = 'none';
                return;
            }

            historyPanel.style.display = 'block';
            historyList.innerHTML = '';

            history.forEach((item, index) => {
                const isReal = item.prediction.includes('Real');
                const historyItem = document.createElement('div');
                historyItem.className = 'history-item';
                historyItem.setAttribute('data-history-index', index);
                historyItem.style.cursor = 'pointer';
                historyItem.innerHTML = `
                    <div class="history-item-info">
                        <div class="history-item-name">${item.name}</div>
                        <div class="history-item-time">${item.timestamp}</div>
                    </div>
                    <div class="history-item-badge ${isReal ? 'history-item-badge-real' : 'history-item-badge-fake'}">
                        ${isReal ? '✓ Real' : '✗ Fake'}
                    </div>
                `;
                
                // Add click event listener to load this prediction
                historyItem.addEventListener('click', function() {
                    displayHistoryResult(item);
                });
                
                historyList.appendChild(historyItem);
            });
        }

        function displayHistoryResult(historyItem) {
            currentResult = {
                prediction: historyItem.prediction,
                confidence: historyItem.confidence,
                is_real: historyItem.is_real
            };

            // Display image
            if (historyItem.imageData) {
                resultImage.src = historyItem.imageData;
            } else if (historyItem.imageUrl) {
                resultImage.src = historyItem.imageUrl;
            }

            // Update badge
            predictionBadge.textContent = historyItem.prediction;
            predictionBadge.classList.remove('badge-real', 'badge-fake');
            predictionBadge.classList.add(historyItem.is_real ? 'badge-real' : 'badge-fake');

            // Update result display (confidence remains internal for backend)
            // No confidence display to user for confidentiality

            // Show results page
            goToResultsPage();
            setTimeout(() => {
                loadingSpinner.classList.remove('show');
                resultsDisplay.style.display = 'block';
            }, 300);
        }

        clearHistoryBtn.addEventListener('click', () => {
            if (confirm('Are you sure you want to clear prediction history?')) {
                localStorage.removeItem('predictionHistory');
                loadHistory();
            }
        });

        // ==================== CLEAR FORM ====================
        clearBtn.addEventListener('click', function() {
            fileInput.value = '';
            urlInput.value = '';
            currentFile = null;
            currentUrl = null;
            fileInfo.classList.remove('show');
            clearError();
        });

        // ==================== BACK BUTTON ====================
        backBtn.addEventListener('click', goToUploadPage);

        // ==================== ERROR HANDLING ====================
        function showError(message) {
            errorMessage.textContent = message;
            errorMessage.classList.add('show');
        }

        function showErrorOnResults(message) {
            resultsDisplay.innerHTML = `
                <div style="background: var(--border-light); border: 1px solid var(--border-light); color: var(--danger); padding: 20px; border-radius: 10px; text-align: center;">
                    <p style="font-weight: 600; margin-bottom: 10px;">⚠ Error</p>
                    <p>${message}</p>
                </div>
            `;
            resultsDisplay.style.display = 'block';
        }

        function clearError() {
            errorMessage.classList.remove('show');
        }

        // ==================== ENTER KEY SUPPORT ====================
        urlInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                predictBtn.click();
            }
        });
    </script>
</body>
</html>
